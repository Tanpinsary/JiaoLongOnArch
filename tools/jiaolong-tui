"""Textual frontend for the conservative JiaoLong control CLI."""

from __future__ import annotations

from pathlib import Path

try:
    from textual import events, on, work
    from textual.app import App, ComposeResult
    from textual.containers import Grid, Horizontal, Vertical, VerticalScroll
    from textual.screen import ModalScreen
    from textual.widgets import Button, Footer, Header, Label, Select, Static
except ImportError as error:
    raise SystemExit(
        "Textual is required. Synchronize dependencies with: uv sync"
    ) from error

from jiaolong_tui_model import (
    Dashboard,
    GPU_MODES,
    KEYBOARD_MODES,
    PROFILE_OPTIONS,
    TuiCommandError,
    dashboard_from_status,
    read_status,
    run_action,
)

TOOLS_DIR = Path(__file__).resolve().parent
CONTROL_HELPER = TOOLS_DIR / "jiaolong-helper"


class ConfirmMux(ModalScreen[bool]):
    """Require explicit acknowledgement for a reboot-required MUX write."""

    DEFAULT_CSS = """
    ConfirmMux { align: center middle; }
    ConfirmMux > VerticalScroll {
        width: 64; height: auto; max-height: 18;
        padding: 1 2; border: thick $warning; background: $surface;
    }
    ConfirmMux Horizontal { height: auto; align: center middle; margin-top: 1; }
    ConfirmMux Button { margin: 0 1; }
    """

    def __init__(self, mode: str) -> None:
        super().__init__()
        self.mode = mode

    def compose(self) -> ComposeResult:
        with VerticalScroll():
            yield Label(
                f"Request GPU mode '{self.mode}'?\n\n"
                "The selection requires a manual reboot. The TUI will not reboot."
            )
            with Horizontal():
                yield Button("Cancel", id="cancel")
                yield Button("Confirm", id="confirm", variant="warning")

    @on(Button.Pressed, "#cancel")
    def cancel(self) -> None:
        self.dismiss(False)

    @on(Button.Pressed, "#confirm")
    def confirm(self) -> None:
        self.dismiss(True)


class JiaoLongTui(App[None]):
    """Read status as a user and elevate only reviewed write commands."""

    TITLE = "JiaoLong Control"
    SUB_TITLE = "MRID6 safe firmware controls"
    CSS = """
    Screen { layout: vertical; background: $background; }
    #body { height: 1fr; padding: 1 2; }
    #hero {
        height: 3; padding: 0 1; margin-bottom: 1;
        content-align: left middle; background: $primary 12%;
        border-left: thick $primary;
    }
    #dashboard {
        height: 14; grid-size: 3 2; grid-gutter: 1 2; margin-bottom: 1;
    }
    .metric {
        height: 6; padding: 1 2; border: round $primary-darken-1;
        background: $surface;
    }
    .metric.-healthy { border: round $success-darken-1; }
    .metric-title { color: $text-muted; text-style: bold; }
    .metric-value { text-style: bold; color: $text; }
    #message {
        height: 3; padding: 1 2; margin-bottom: 1;
        border-left: thick $primary; background: $surface;
    }
    #controls-title { height: 2; text-style: bold; padding-left: 1; }
    #controls { height: 14; grid-size: 2 2; grid-gutter: 1 2; }
    .control-card {
        height: 6; padding: 0 1; border: round $primary-darken-2;
        background: $surface;
    }
    .control-card Label { height: 2; padding-top: 1; text-style: bold; }
    .control-card Horizontal { height: 3; }
    .control-card Select { width: 1fr; }
    .control-card Button { width: 13; margin-left: 1; }
    Screen.compact #dashboard { height: 26; grid-size: 2 3; }
    Screen.compact #controls { height: 26; grid-size: 1 4; }
    """
    BINDINGS = [("r", "refresh", "Refresh"), ("q", "quit", "Quit")]

    def compose(self) -> ComposeResult:
        yield Header()
        with VerticalScroll(id="body"):
            yield Static(
                "[b]MRID6 SYSTEM DASHBOARD[/b]  •  live firmware telemetry", id="hero"
            )
            with Grid(id="dashboard"):
                yield Static("Loading…", id="temperature", classes="metric")
                yield Static("Loading…", id="fans", classes="metric")
                yield Static("Loading…", id="profile-status", classes="metric")
                yield Static("Loading…", id="gpu-status", classes="metric")
                yield Static("Loading…", id="keyboard-status", classes="metric")
                yield Static("Loading…", id="driver-status", classes="metric")
            yield Static("", id="message")
            yield Label("CONTROLS", id="controls-title")
            with Grid(id="controls"):
                with Vertical(classes="control-card"):
                    yield Label("Performance profile")
                    with Horizontal():
                        yield Select.from_values(PROFILE_OPTIONS, id="profile")
                        yield Button("Apply", id="apply-profile", variant="primary")
                with Vertical(classes="control-card"):
                    yield Label("Keyboard mode")
                    with Horizontal():
                        yield Select.from_values(KEYBOARD_MODES, id="keyboard-mode")
                        yield Button("Apply", id="apply-keyboard-mode")
                with Vertical(classes="control-card"):
                    yield Label("Keyboard brightness")
                    with Horizontal():
                        yield Select.from_values(("0", "1", "2", "3"), id="brightness")
                        yield Button("Apply", id="apply-brightness")
                with Vertical(classes="control-card"):
                    yield Label("GPU mode (reboot)")
                    with Horizontal():
                        yield Select.from_values(GPU_MODES, id="gpu-mode")
                        yield Button("Request", id="apply-gpu", variant="warning")
        yield Footer()

    def on_mount(self) -> None:
        self.refresh_status()
        self.set_interval(5, self.refresh_status)

    def on_resize(self, event: events.Resize) -> None:
        self.screen.set_class(event.size.width < 85, "compact")

    def action_refresh(self) -> None:
        self.refresh_status()

    @work(thread=True, exclusive=True, group="status")
    def refresh_status(self) -> None:
        try:
            view = dashboard_from_status(read_status())
        except TuiCommandError as error:
            self.call_from_thread(self.show_message, f"Status error: {error}", True)
            return
        self.call_from_thread(self.update_dashboard, view)

    def update_dashboard(self, view: Dashboard) -> None:
        self.query_one("#temperature", Static).update(
            f"[dim b]TEMPERATURE[/dim b]\n[bold cyan]{view.temperature}[/bold cyan]"
        )
        self.query_one("#fans", Static).update(
            f"[dim b]FAN CHANNELS[/dim b]\n[bold]{view.fans}[/bold]"
        )
        self.query_one("#profile-status", Static).update(
            f"[dim b]PROFILE[/dim b]\n[bold green]{view.profile}[/bold green]"
        )
        self.query_one("#gpu-status", Static).update(
            f"[dim b]GPU MODE[/dim b]\n[bold yellow]{view.gpu_mode}[/bold yellow]"
        )
        self.query_one("#keyboard-status", Static).update(
            f"[dim b]KEYBOARD[/dim b]\n[bold]{view.keyboard}[/bold]"
        )
        driver_color = "green" if view.write_ready else "red"
        self.query_one("#driver-status", Static).update(
            f"[dim b]DRIVER / HARDWARE[/dim b]\n"
            f"[{driver_color} b]{view.driver}[/{driver_color} b]\n[dim]{view.hardware}[/dim]"
        )
        for button in self.query(Button):
            if button.id and button.id.startswith("apply-"):
                button.disabled = not view.write_ready
        self.set_initial_values(view)

    def set_initial_values(self, view: Dashboard) -> None:
        values = {
            "#profile": view.profile_option,
            "#keyboard-mode": view.keyboard_mode,
            "#brightness": view.brightness,
            "#gpu-mode": view.gpu_mode,
        }
        for selector, value in values.items():
            select = self.query_one(selector, Select)
            if select.is_blank() and isinstance(value, str):
                select.value = value

    def show_message(self, message: str, error: bool = False) -> None:
        widget = self.query_one("#message", Static)
        widget.update(message)
        widget.styles.color = "red" if error else "green"

    def selected(self, selector: str) -> str | None:
        value = self.query_one(selector, Select).value
        return value if isinstance(value, str) else None

    @work(thread=True, exclusive=True, group="action")
    def execute(self, arguments: tuple[str, ...]) -> None:
        try:
            message = run_action(CONTROL_HELPER, arguments)
        except TuiCommandError as error:
            self.call_from_thread(self.show_message, str(error), True)
            return
        self.call_from_thread(self.show_message, message)
        self.call_from_thread(self.refresh_status)

    @on(Button.Pressed, "#apply-profile")
    def apply_profile(self) -> None:
        if value := self.selected("#profile"):
            self.execute(("profile", value))

    @on(Button.Pressed, "#apply-keyboard-mode")
    def apply_keyboard_mode(self) -> None:
        if value := self.selected("#keyboard-mode"):
            self.execute(("keyboard-mode", value))

    @on(Button.Pressed, "#apply-brightness")
    def apply_brightness(self) -> None:
        if value := self.selected("#brightness"):
            self.execute(("keyboard-brightness", value))

    @on(Button.Pressed, "#apply-gpu")
    def apply_gpu(self) -> None:
        if value := self.selected("#gpu-mode"):
            self.push_screen(ConfirmMux(value), self.finish_gpu)

    def finish_gpu(self, confirmed: bool | None) -> None:
        if confirmed and (value := self.selected("#gpu-mode")):
            self.execute(("gpu-mode", value, "--confirm-reboot-required"))


if __name__ == "__main__":
    JiaoLongTui().run()
